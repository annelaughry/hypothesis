# Secret Key for Django (should be kept secret)
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode (True for development, False for production)
DJANGO_DEBUG=True

# Allowed Hosts for your project (comma-separated for multiple hosts)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database configurations (if using a different database)
#DJANGO_DB_ENGINE=django.db.backends.postgresql
#DJANGO_DB_NAME=your_db_name
#DJANGO_DB_USER=your_db_user
#DJANGO_DB_PASSWORD=your_db_password
#DJANGO_DB_HOST=localhost
#DJANGO_DB_PORT=5432

# SendGrid (required in production, optional in development)
SENDGRID_API_KEY=

# Slack bot token (required to send Slack notifications)
SLACK_BOT_TOKEN=
